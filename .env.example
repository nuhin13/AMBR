# ─────────────────────────────────────────────────────────────────────────────
# AMBR environment variables. Copy to .env (local) or set in your host's dashboard.
# NEVER commit real values. Only NEXT_PUBLIC_* variables are visible in the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Core (required)
DATABASE_URL="postgresql://ambr:ambr_dev_password@localhost:5433/ambr?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"          # production: https://ambrbd.com
AUTH_SECRET=""                                         # 32+ random chars:  openssl rand -base64 48
PAYMENT_MODE="sandbox"                                 # sandbox | live  (also switches courier APIs)

# First owner account (used by `npm run db:seed`)
SEED_OWNER_EMAIL="owner@ambrbd.com"
SEED_OWNER_PASSWORD=""                                 # required in production

# Scheduled jobs — the cron caller sends:  Authorization: Bearer $CRON_SECRET
CRON_SECRET=""

# ── Payments (each method appears at checkout only when enabled in Admin → Payments AND configured here)
# bKash Tokenized Checkout (merchant PGW credentials from bKash)
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
# Nagad Payment Gateway (merchant id + RSA keys issued during onboarding; PEM or bare base64)
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_PRIVATE_KEY=""
NAGAD_PG_PUBLIC_KEY=""
# SSLCommerz (cards)
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""

# ── Couriers
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
STEADFAST_WEBHOOK_TOKEN=""                             # the Bearer token you set in the Steadfast webhook settings
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
PATHAO_USERNAME=""
PATHAO_PASSWORD=""
PATHAO_STORE_ID=""
PATHAO_WEBHOOK_SECRET=""

# ── Images (required in production — serverless disks are not persistent)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Email (order confirmations, password resets). Without a key, emails are logged instead.
RESEND_API_KEY=""
EMAIL_FROM="AMBR <orders@ambrbd.com>"

# ── Analytics & marketing (optional)
NEXT_PUBLIC_GA4_ID=""                                  # G-XXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=""
META_CAPI_TOKEN=""

# ── Docker production stack only (docker-compose.prod.yml) — DATABASE_URL is built from these
POSTGRES_USER="ambr"
POSTGRES_PASSWORD=""                                   # strong random password
POSTGRES_DB="ambr"
DOMAIN="ambrbd.com"                                    # Caddy issues HTTPS for this domain (+ www redirect)
BACKUP_HOUR="21"                                       # UTC hour for the nightly dump (21 = 03:00 Dhaka)
RETENTION_DAYS="30"

# ── Logging
LOG_LEVEL="info"

// AMBR — database schema
// Money is always stored as integer poisha (৳1 = 100 poisha).
// See doc/04-database/erd.md for the design rationale.

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Identity ─────────────────────────────

enum Role {
  CUSTOMER
  STAFF_ORDERS
  STAFF_CATALOG
  ADMIN
  OWNER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id              String     @id @default(cuid())
  email           String?    @unique
  phone           String?    @unique // E.164, e.g. +8801712345678
  passwordHash    String?
  name            String
  role            Role       @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  profile        CustomerProfile?
  sessions       Session[]
  resetTokens    PasswordResetToken[]
  addresses      Address[]
  orders         Order[]
  reviews        Review[]
  wishlist       WishlistItem[]
  cart           Cart?
  auditLogs      AuditLog[]
  statusChanges  OrderStatusHistory[]
  stockMovements InventoryMovement[]
  referralCode   ReferralCode?

  @@index([role])
}

model Session {
  id        String   @id // SHA-256 hash of the session token; the raw token only lives in the cookie
  userId    String
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomerProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  dateOfBirth    DateTime?
  marketingOptIn Boolean   @default(false)
  adminNotes     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String   @default("Home")
  recipientName String
  phone         String
  districtId    Int
  upazilaId     Int?
  line          String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  district      District @relation(fields: [districtId], references: [id])
  upazila       Upazila? @relation(fields: [upazilaId], references: [id])

  @@index([userId])
}

model ReferralCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Geography & shipping ─────────────────────────────

model Division {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  nameBn    String?
  districts District[]
}

model District {
  id             Int           @id @default(autoincrement())
  divisionId     Int
  name           String        @unique
  nameBn         String?
  shippingZoneId String
  division       Division      @relation(fields: [divisionId], references: [id])
  shippingZone   ShippingZone  @relation(fields: [shippingZoneId], references: [id])
  upazilas       Upazila[]
  addresses      Address[]

  @@index([shippingZoneId])
}

model Upazila {
  id             Int           @id @default(autoincrement())
  districtId     Int
  name           String
  nameBn         String?
  isCityArea     Boolean       @default(false)
  // Optional override of the district's zone (e.g. Savar → Dhaka Suburbs)
  shippingZoneId String?
  district       District      @relation(fields: [districtId], references: [id])
  shippingZone   ShippingZone? @relation(fields: [shippingZoneId], references: [id])
  addresses      Address[]

  @@unique([districtId, name])
}

model ShippingZone {
  id                    String     @id @default(cuid())
  name                  String
  slug                  String     @unique
  fee                   Int // poisha
  freeShippingThreshold Int? // poisha; null = never free by threshold
  estimatedDays         String     @default("2–3 days")
  isActive              Boolean    @default(true)
  sortOrder             Int        @default(0)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  districts             District[]
  upazilas              Upazila[]
}

// ───────────────────────────── Catalogue ─────────────────────────────

enum CategoryStatus {
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum CategoryType {
  PERFUME
  ATTAR
  BODY_MIST
  CAR
  HOME
  PET
  MINI
  GIFT
  OTHER
}

model Category {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  type        CategoryType   @default(OTHER)
  tagline     String?
  description String?
  imageUrl    String?
  imageAlt    String?
  status      CategoryStatus @default(HIDDEN)
  sortOrder   Int            @default(0)
  parentId    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  parent      Category?      @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]     @relation("CategoryTree")
  products    Product[]

  @@index([status, sortOrder])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Intensity {
  LIGHT
  MODERATE
  STRONG
}

enum Season {
  SUMMER
  MONSOON
  WINTER
  ALL_YEAR
}

model Product {
  id                String        @id @default(cuid())
  slug              String        @unique
  categoryId        String
  name              String
  shortDescription  String
  description       String // sanitised rich text (HTML allow-list)
  productType       String // e.g. "Perfume Oil Spray" / "Attar Roll-on"
  intensity         Intensity     @default(MODERATE)
  seasons           Season[]
  applicationMethod String?
  usageInstructions String?
  safetyNote        String?
  inspirationNote   String?
  status            ProductStatus @default(DRAFT)
  isBestSeller      Boolean       @default(false)
  isNewArrival      Boolean       @default(false)
  isFeatured        Boolean       @default(false)
  isDemo            Boolean       @default(false)
  salesCount        Int           @default(0)
  seoTitle          String?
  seoDescription    String?
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  category     Category             @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]
  images       ProductImage[]
  families     ProductFamily[]
  notes        ProductNote[]
  occasions    ProductOccasion[]
  collections  CollectionProduct[]
  reviews      Review[]
  wishlist     WishlistItem[]
  translations ProductTranslation[]
  performance  ProductPerformance?

  @@index([status, categoryId])
  @@index([status, isBestSeller])
  @@index([status, isNewArrival])
  @@index([salesCount])
}

/// Only rendered when testMethodNote is present — never invent performance data.
model ProductPerformance {
  id             String   @id @default(cuid())
  productId      String   @unique
  longevity      String? // e.g. "6–7 hours on skin"
  projection     String? // e.g. "Moderate — arm's length"
  testMethodNote String // how and by whom it was tested
  testedAt       DateTime
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductTranslation {
  id               String  @id @default(cuid())
  productId        String
  locale           String // "bn"
  name             String
  shortDescription String
  description      String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

enum VariantStatus {
  ACTIVE
  ARCHIVED
}

model ProductVariant {
  id             String        @id @default(cuid())
  productId      String
  sku            String        @unique
  sizeMl         Int
  label          String // "10 ml"
  price          Int // poisha
  compareAtPrice Int? // poisha — shows a strike-through when higher than price
  status         VariantStatus @default(ACTIVE)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  movements  InventoryMovement[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  images     ProductImage[]

  @@unique([productId, sizeMl])
  @@index([productId, status])
  @@index([price])
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  variantId String?
  url       String
  storageId String? // Cloudinary public_id or local path
  alt       String
  width     Int?
  height    Int?
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
}

model FragranceFamily {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String?
  sortOrder   Int             @default(0)
  products    ProductFamily[]
}

model ProductFamily {
  productId String
  familyId  String
  isPrimary Boolean         @default(false)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  family    FragranceFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([productId, familyId])
  @@index([familyId])
}

model FragranceNote {
  id       String        @id @default(cuid())
  slug     String        @unique
  name     String
  products ProductNote[]
}

enum NoteTier {
  TOP
  HEART
  BASE
}

model ProductNote {
  productId String
  noteId    String
  tier      NoteTier
  sortOrder Int           @default(0)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  note      FragranceNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([productId, noteId, tier])
  @@index([noteId])
}

model Occasion {
  id        String            @id @default(cuid())
  slug      String            @unique
  name      String
  sortOrder Int               @default(0)
  products  ProductOccasion[]
}

model ProductOccasion {
  productId  String
  occasionId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@id([productId, occasionId])
  @@index([occasionId])
}

enum CollectionStatus {
  PUBLISHED
  HIDDEN
}

model Collection {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String
  description String?
  imageUrl    String?
  imageAlt    String?
  status      CollectionStatus    @default(HIDDEN)
  isFeatured  Boolean             @default(false)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  products    CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

// ───────────────────────────── Inventory ─────────────────────────────

model Inventory {
  variantId         String         @id
  onHand            Int            @default(0)
  reserved          Int            @default(0)
  lowStockThreshold Int            @default(5)
  updatedAt         DateTime       @updatedAt
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

enum MovementType {
  PURCHASE_IN
  ADJUSTMENT
  ORDER_RESERVE
  RESERVE_RELEASE
  ORDER_FULFIL
  RETURN_IN
  DAMAGE
}

/// Append-only stock ledger.
model InventoryMovement {
  id            String         @id @default(cuid())
  variantId     String
  type          MovementType
  quantity      Int // signed change to the field it affects (onHand or reserved)
  onHandAfter   Int
  reservedAfter Int
  orderId       String?
  userId        String?
  reason        String?
  createdAt     DateTime       @default(now())
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order         Order?         @relation(fields: [orderId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])

  @@index([variantId, createdAt(sort: Desc)])
  @@index([orderId])
}

// ───────────────────────────── Cart ─────────────────────────────

model Cart {
  id             String     @id @default(cuid())
  userId         String?    @unique
  guestToken     String?    @unique
  couponCode     String?
  contactPhone   String?
  contactEmail   String?
  lastActivityAt DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          CartItem[]

  @@index([lastActivityAt])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

// ───────────────────────────── Orders & payments ─────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  CARD
}

model Order {
  id                   String        @id @default(cuid())
  orderNumber          String        @unique
  userId               String?
  guestAccessToken     String        @unique
  idempotencyKey       String        @unique
  status               OrderStatus   @default(PENDING)
  paymentStatus        PaymentStatus @default(UNPAID)
  paymentMethod        PaymentMethod
  customerName         String
  phone                String
  email                String?
  // Address snapshot — copied, never referenced, so later edits don't alter history
  districtName         String
  upazilaName          String?
  addressLine          String
  deliveryInstructions String?
  shippingZoneName     String
  subtotal             Int
  discountTotal        Int           @default(0)
  shippingFee          Int
  total                Int
  couponCode           String?
  reservationExpiresAt DateTime? // for online payments awaiting confirmation
  adminNotes           String?
  isDemo               Boolean       @default(false)
  placedAt             DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  history       OrderStatusHistory[]
  payments      Payment[]
  shipment      Shipment?
  movements     InventoryMovement[]
  redemption    CouponRedemption?

  @@index([status, placedAt(sort: Desc)])
  @@index([paymentStatus])
  @@index([phone])
  @@index([userId, placedAt(sort: Desc)])
  @@index([reservationExpiresAt])
}

model OrderItem {
  id           String         @id @default(cuid())
  orderId      String
  variantId    String
  productId    String
  productName  String // snapshot
  productSlug  String // snapshot
  variantLabel String // snapshot
  sku          String // snapshot
  unitPrice    Int // snapshot, poisha
  quantity     Int
  lineTotal    Int
  imageUrl     String?
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  review       Review?

  @@index([orderId])
  @@index([variantId])
  @@index([productId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String?
  createdAt   DateTime     @default(now())
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy   User?        @relation(fields: [changedById], references: [id])

  @@index([orderId, createdAt])
}

enum PaymentProvider {
  COD
  BKASH
  NAGAD
  SSLCOMMERZ
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  status            PaymentStatus   @default(PENDING)
  amount            Int
  providerPaymentId String? // gateway's payment / session id
  providerTrxId     String? // gateway's transaction id
  rawResponse       Json?
  verifiedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@index([orderId])
}

enum Courier {
  PATHAO
  STEADFAST
  MANUAL
}

model Shipment {
  id            String   @id @default(cuid())
  orderId       String   @unique
  courier       Courier
  consignmentId String?
  trackingCode  String?
  trackingUrl   String?
  status        String?
  codAmount     Int?
  events        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([consignmentId])
}

// ───────────────────────────── Promotions ─────────────────────────────

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model Campaign {
  id          String    @id @default(cuid())
  name        String
  description String?
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  coupons     Coupon[]
  banners     Banner[]
}

model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique // stored uppercase
  description      String?
  type             CouponType
  value            Int // percent (1–100) for PERCENT, poisha for FIXED, ignored for FREE_SHIPPING
  maxDiscount      Int? // poisha cap for PERCENT
  minSubtotal      Int? // poisha
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perCustomerLimit Int?
  usedCount        Int                @default(0)
  isActive         Boolean            @default(true)
  campaignId       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  campaign         Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  redemptions      CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  orderId   String   @unique
  userId    String?
  phone     String
  amount    Int
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, phone])
}

// ───────────────────────────── Engagement ─────────────────────────────

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Reviews require a delivered order item — every review is a verified purchase.
model Review {
  id          String       @id @default(cuid())
  productId   String
  userId      String
  orderItemId String       @unique
  rating      Int
  title       String?
  body        String
  status      ReviewStatus @default(PENDING)
  approvedAt  DateTime?
  createdAt   DateTime     @default(now())
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([status, createdAt])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id             String           @id @default(cuid())
  email          String           @unique
  status         SubscriberStatus @default(SUBSCRIBED)
  source         String?
  unsubscribeKey String           @unique @default(cuid())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

// ───────────────────────────── Content ─────────────────────────────

enum BannerPlacement {
  HOME_HERO
  ANNOUNCEMENT
  PROMO
}

model Banner {
  id           String          @id @default(cuid())
  placement    BannerPlacement
  eyebrow      String?
  title        String
  subtitle     String?
  imageDesktop String?
  imageMobile  String?
  imageAlt     String?
  ctaLabel     String?
  ctaHref      String?
  cta2Label    String?
  cta2Href     String?
  startsAt     DateTime?
  endsAt       DateTime?
  sortOrder    Int             @default(0)
  isActive     Boolean         @default(true)
  campaignId   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  campaign     Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([placement, isActive, sortOrder])
}

model ContentPage {
  id             String   @id @default(cuid())
  slug           String   @unique // "about", "shipping-policy", …
  title          String
  body           String // sanitised HTML
  seoDescription String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("General")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomepageSection {
  key       String  @id // "categories", "bestSellers", …
  isEnabled Boolean @default(true)
  sortOrder Int     @default(0)
  title     String?
  subtitle  String?
}

model StoreSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ───────────────────────────── System ─────────────────────────────

/// Append-only admin activity log.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // "product.update", "order.status", …
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}
